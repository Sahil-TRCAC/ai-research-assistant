# ─────────────────────────────────────────────
#  AI Research Assistant — Environment Template
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-me-to-a-long-random-secret-key
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_research_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log

# Redis (for future Celery tasks)
REDIS_URL=redis://localhost:6379/0

# Groq LLM — get a free key at https://console.groq.com
# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TEMPERATURE=0
# GROQ_MAX_TOKENS=1024
